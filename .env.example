# ══════════════════════════════════════════════
# TIMORA — Environment Configuration Template
# Copy this file to .env and fill in real values.
# NEVER commit .env files or real secrets to Git.
# ══════════════════════════════════════════════

# ── Application ──────────────────────────────
NODE_ENV=development
PORT=3001

# Frontend URL (used for CORS + email links)
FRONTEND_URL=https://timorah.me

# Comma-separated allowed CORS origins
CORS_ORIGINS=https://timorah.me,https://www.timorah.me,http://localhost:5173

# ── Database ─────────────────────────────────
# Full PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/timora_dev

# Set to "true" for managed cloud PostgreSQL (Neon, Supabase Postgres)
DATABASE_SSL=false

# ── Authentication ───────────────────────────
# Must be a long, random, secret string (256-bit recommended)
JWT_SECRET=replace-with-a-very-long-random-secret

# Access token lifetime (e.g. 15m, 1h)
JWT_ACCESS_EXPIRES=15m

# Refresh token lifetime (e.g. 7d, 30d)
JWT_REFRESH_EXPIRES=7d

# ── PIN Hashing (Argon2id) ───────────────────
# Memory cost in KB (default: 65536 = 64MB)
ARGON2_MEMORY=65536
# Iterations (default: 3)
ARGON2_ITERATIONS=3
# Parallelism (default: 4)
ARGON2_PARALLELISM=4

# ── OTP Configuration ────────────────────────
# CRITICAL: Set to "false" in production — OTP_DEMO_MODE=false
# When true, OTP is printed to server logs only (never sent via SMS).
# This value is validated at startup; the app refuses to start in
# production (NODE_ENV=production) if OTP_DEMO_MODE is "true".
OTP_DEMO_MODE=true

# OTP expiry in seconds (default: 300 = 5 minutes)
OTP_EXPIRY_SECONDS=300

# Maximum OTP verification attempts before invalidation
OTP_MAX_ATTEMPTS=3

# Rate limit: window in seconds
OTP_RATE_LIMIT_WINDOW=900

# Rate limit: max OTP send requests per window per phone
OTP_RATE_LIMIT_MAX=3

# ── Twilio (Production SMS OTP) ───────────────
# Required when OTP_DEMO_MODE=false
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your DLT-registered Sender ID (required for India)
TWILIO_SENDER_ID=

# ── Supabase Storage ──────────────────────────
# Get from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co

# Service Role Key — BACKEND ONLY. NEVER expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket name for timber listing images
SUPABASE_STORAGE_BUCKET=timber-listings

# Max image file size in bytes (default: 10MB)
IMAGE_MAX_SIZE_BYTES=10485760

# ── Super Admin Bootstrap ─────────────────────
# Phone number for the initial Super Admin account (+91XXXXXXXXXX)
SUPER_ADMIN_PHONE=+919999999999

# Run: npm run db:seed --workspace=apps/api  to create the admin account
# The seed script will prompt for the PIN and hash it securely.

# ── Logging ──────────────────────────────────
# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ── Listing Configuration ─────────────────────
# Days before a listing requires stock reconfirmation
LISTING_EXPIRY_DAYS=90

# Grace period (days) after expiry before listing is hidden
LISTING_EXPIRY_GRACE_DAYS=7

# ── Rate Limiting ─────────────────────────────
# Login: max attempts per window
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW=900

# General API rate limit
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW=60
