# TIMORA Web Application Environment Configuration
# Copy this file to .env or set environment variables in your deployment dashboard (e.g. Vercel, Netlify).

# Base URL for the Express REST API backend
# In local development: defaults to http://localhost:3001/api/v1
# In production: set to your deployed backend URL, e.g. https://api.timorah.me/api/v1
VITE_API_URL=http://localhost:3001/api/v1
