{
  "name": "@timora/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:concurrency": "vitest run src/__tests__/concurrency.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts"
  },
  "dependencies": {
    "@timora/shared": "*",
    "express": "^4.21.2",
    "argon2": "^0.41.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "express-rate-limit": "^7.4.1",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "twilio": "^5.3.7",
    "@supabase/supabase-js": "^2.46.2",
    "uuid": "^11.0.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/pg": "^8.11.10",
    "@types/cors": "^2.8.17",
    "@types/multer": "^1.4.12",
    "@types/uuid": "^10.0.0",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.5",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2"
  }
}
